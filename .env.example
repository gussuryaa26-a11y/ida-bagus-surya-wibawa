# PostgreSQL connection (production / external database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simpar

# Development-only embedded PostgreSQL (npm run db:start)
DEV_DB_PORT=55432
DEV_DB_DIR=.data/pg
DEV_DB_USER=postgres
DEV_DB_PASSWORD=postgres
DEV_DB_NAME=simpar

# Session signing / hashing pepper. Use a long random value in production.
AUTH_SECRET=change-me-to-a-long-random-value

# Token for scheduled deadline/expiry job endpoint (POST /api/internal/jobs/deadlines)
INTERNAL_JOB_TOKEN=change-me-internal-job-token

# Directory for generated Internal Memo PDFs (default: .data/memos)
MEMO_STORAGE_DIR=.data/memos

# Seed/demo credentials (DEVELOPMENT ONLY, never use in production)
SEED_DEMO_PASSWORD=Demo1234!

# Operational defaults (only used if the DB settings row is reset)
DEFAULT_TIMEZONE=Asia/Makassar
